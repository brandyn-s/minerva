{
  "name": "minerva",
  "version": "0.0.0",
  "private": true,
  "description": "A spatial thinking environment for directing AI with explicit context and durable lineage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandyn-s/minerva.git"
  },
  "bugs": {
    "url": "https://github.com/brandyn-s/minerva/issues"
  },
  "homepage": "https://github.com/brandyn-s/minerva#readme",
  "engines": {
    "node": "^24.15.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "expedition:worker": "node scripts/expedition-worker.mjs",
    "test:expedition": "node scripts/verify-browser.mjs expedition",
    "eval:expedition": "node scripts/evaluate-expeditions.mjs",
    "test:expedition-process": "node scripts/verify-expedition-process.mjs",
    "test:expedition-scale": "node scripts/verify-expedition-scale.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "ai": "7.0.94",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "workflow": "4.8.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
