{
  "name": "minerva",
  "version": "0.0.0",
  "private": true,
  "description": "A spatial thinking environment for directing AI with explicit context and durable lineage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandyn-s/minerva.git"
  },
  "bugs": {
    "url": "https://github.com/brandyn-s/minerva/issues"
  },
  "homepage": "https://github.com/brandyn-s/minerva#readme",
  "engines": {
    "node": "^24.15.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "node scripts/verify-atlas.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "ai": "7.0.94",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pg": "8.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "workflow": "4.8.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@workflow/core": { "nanoid": "5.1.16" },
    "@workflow/world-local": { "undici": "7.29.0" },
    "@workflow/world-vercel": { "undici": "7.29.0" },
    "@esbuild-kit/core-utils": { "esbuild": "0.25.12" }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
