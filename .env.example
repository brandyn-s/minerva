# Local AI Gateway credential from `vercel env pull`; never commit its value.
VERCEL_OIDC_TOKEN=
# Optional exact origins for a different local port or explicitly configured serving hostname.
# Preview deployments also allow their Vercel-provided immutable deployment hostname.
MINERVA_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Voice-only Gateway API key; load securely from Keychain locally. Never NEXT_PUBLIC_.
MINERVA_PRIME_VOICE_API=

# Hosted Expedition: injected by the existing Neon integration.
EXPEDITION_DATABASE_URL=
# Synthetic verification only; omit for real hosted runs.
# MINERVA_EXPERIMENT_PROVIDER=fixture
